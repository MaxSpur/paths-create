{
  "name": "origin-destination-creator",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": "^24.15.0 || >=26.0.0",
    "npm": ">=11.12.1"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "check": "npm run test:run && npm run build && npm run bundle:check",
    "benchmark": "vitest bench --run",
    "bundle:check": "node scripts/check-bundle-size.mjs",
    "test": "vitest",
    "test:run": "vitest run",
    "ors:install": "node scripts/ors-install.mjs",
    "ors:start": "node scripts/local-ors.mjs start",
    "ors:status": "node scripts/local-ors.mjs status",
    "ors:stop": "node scripts/local-ors.mjs stop",
    "ors:benchmark": "node scripts/benchmark-local-ors.mjs"
  },
  "dependencies": {
    "jszip": "^3.10.1",
    "leaflet": "^1.9.4"
  },
  "devDependencies": {
    "@types/leaflet": "1.9.22",
    "@types/node": "26.2.0",
    "jsdom": "30.0.1",
    "typescript": "7.0.2",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  }
}
